# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=uxdb
POSTGRES_USER=uxuser
POSTGRES_PASSWORD=change-me

# ── Gateway (Spring Boot) ─────────────────────────────────────────────
# Origin allowed to call the gateway API (CORS)
FRONTEND_ORIGIN=http://localhost:4200
# Internal service URLs (docker-compose service names)
LLM_API_URL=http://fastapi-llm:5000
VISION_API_URL=http://fastapi-vision:5001

# ── LLM provider ──────────────────────────────────────────────────────
# openai | mistral | deepseek | openrouter | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
#MISTRAL_API_KEY=
#DEEPSEEK_API_KEY=
#OPENROUTER_API_KEY=

# Optional model overrides (defaults: gpt-4o-mini / mistral-small-latest /
# deepseek-chat / mistralai/mistral-7b-instruct)
#OPENAI_MODEL=
#MISTRAL_MODEL=
#DEEPSEEK_MODEL=
#OPENROUTER_MODEL=

# ── Ollama (fully local, no API key needed) ───────────────────────────
#LLM_PROVIDER=ollama
#OLLAMA_ENDPOINT=http://ollama:11434
#OLLAMA_MODEL=llama3.1:8b
